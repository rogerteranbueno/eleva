# ─────────────────────────────────────────────
# ELEVA — Variables de entorno
# Copia este archivo como `.env.local` y llena los valores.
# NUNCA subas `.env.local` a git — ya está en .gitignore.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Obtén estos valores en: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Solo en servidor — nunca en NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (emails transaccionales) ───────────
# Obtén tu API key en: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=hola@elevaapp.io

# ── Auth (cuando se integre) ──────────────────
# NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# ── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo gate (portal de demo protegido) ──────
# Token QA: acceso inmediato sin email (para equipo interno y QA)
# Genera uno con: openssl rand -hex 16
DEMO_QA_TOKEN=cambia-esto-por-un-token-seguro
# Webhook opcional para capturar leads del demo (ej. Make / Zapier / n8n)
# Deja vacío si no necesitas captura de leads
DEMO_LEAD_WEBHOOK=
